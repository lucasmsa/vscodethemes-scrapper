{
  "name": "vscodethemes",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "scrape": "npm run scrape -w @vscodethemes/scrape --",
    "index": "npm run build:index -w @vscodethemes/scrape",
    "eval": "npm run eval -w @vscodethemes/scrape --",
    "dev": "npm run dev -w @vscodethemes/web",
    "build": "npm run build:index -w @vscodethemes/scrape && npm run build -w @vscodethemes/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\" \"docs/**/*.md\" README.md"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
